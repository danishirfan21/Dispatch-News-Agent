# Backboard API credentials — copy this file to .env and fill in real values.
# Never commit the real .env file.
BACKBOARD_API_KEY=

# Backboard model/provider configuration. Kept isolated here so the model
# can be swapped without touching application logic.
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_MODEL=~moonshotai/kimi-latest
BACKBOARD_LLM_PROVIDER=openrouter

# SerpApi credentials — copy this file to .env and fill in real values.
SERPAPI_API_KEY=

# SerpApi configuration. Kept small on purpose: free-plan quota is limited.
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_RESULTS_PER_INTEREST=4

# Frontend origin allowed to call this API in local development.
FRONTEND_ORIGIN=http://localhost:5173
