# Backboard API credentials — copy this file to .env and fill in real values.
# Never commit the real .env file.
BACKBOARD_API_KEY=

# Backboard model/provider configuration. Kept isolated here so the model
# can be swapped without touching application logic.
BACKBOARD_BASE_URL=https://app.backboard.io/api
BACKBOARD_MODEL=~moonshotai/kimi-latest
BACKBOARD_LLM_PROVIDER=openrouter

# SerpApi credentials — copy this file to .env and fill in real values.
SERPAPI_API_KEY=

# SerpApi configuration. Kept small on purpose: free-plan quota is limited.
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_RESULTS_PER_INTEREST=4

# Frontend origin allowed to call this API in local development.
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string — copy this file to .env and fill in real values.
MONGODB_URI=
MONGODB_DB_NAME=dispatch

# Secret used to sign auth JWTs. Generate a long random value for real use,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=20160

# Set to true once served over HTTPS in production so the auth cookie
# requires a secure connection.
COOKIE_SECURE=false

# ElevenLabs credentials — copy this file to .env and fill in real values.
ELEVENLABS_API_KEY=

# ElevenLabs Speech-to-Text configuration.
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_STT_MODEL=scribe_v2

# Voice/model used to narrate the Brief. Kept isolated here so either can be
# swapped without touching request-handling logic.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2

# Backend-only secret required (as `Authorization: Bearer <value>`) to call
# the internal automatic-monitor endpoint. Never reuse JWT_SECRET here.
# Generate with `python -c "import secrets; print(secrets.token_hex(32))"`.
MONITOR_SECRET=

# How often an active Watch is eligible for an automatic check, and how many
# due Watches the monitor processes in a single run.
WATCH_CHECK_INTERVAL_MINUTES=60
WATCH_MONITOR_BATCH_SIZE=10

# Mailjet credentials — copy this file to .env and fill in real values.
# Never commit the real .env file.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Dispatch

# How many pending notifications the delivery worker processes in one run.
NOTIFICATION_DELIVERY_BATCH_SIZE=10
